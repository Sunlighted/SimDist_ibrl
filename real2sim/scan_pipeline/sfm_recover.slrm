#!/bin/bash
#SBATCH --account=aip-rhinehar
#SBATCH --job-name=sfm_recover
#SBATCH --nodes=1
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=12
#SBATCH --mem=64G
#SBATCH --time=2:59:00
#SBATCH --output=/scratch/yifanr/gsbench/logs/sfm_recover_%j.out
#SBATCH --error=/scratch/yifanr/gsbench/logs/sfm_recover_%j.out
#
# The merged mapper fragmented: 50 models, largest 355/800 images (but all three
# sweeps linked in it). Re-running SfM would cost another 5 h; the expensive part
# (features + 320k exhaustive pairs) is already cached in database.db, so instead
# grow the largest model with `image_registrator`, which reuses those matches to
# pull in the unregistered frames, then bundle-adjust + retriangulate.
#
# Likely cause of the fragmentation, for the record: the keep-ranges cut each
# sweep into disconnected segments, and ~68% of the aux frames are mostly
# featureless (white wall / white backdrop), so consecutive segments share too
# few features to chain.
set -uo pipefail
cd /scratch/yifanr/gsbench
W=/scratch/yifanr/gsbench/sfm_merged
module load StdEnv/2023 gcc/12.3 openmpi/4.1.5 cuda/12.6 colmap/3.12.6 >/dev/null 2>&1
source /project/6101830/yifanr/SimDist_ibrl/set_env_drac.sh >/dev/null 2>&1

BEST=$(python - <<'PY'
import glob, struct
best, n = None, -1
for p in glob.glob("/scratch/yifanr/gsbench/sfm_merged/sparse/*/images.bin"):
    k = struct.unpack("<Q", open(p, "rb").read(8))[0]
    if k > n: best, n = p.rsplit("/",1)[0], k
print(best)
PY
)
echo "=== growing $BEST"
IN=$BEST
for ROUND in 1 2; do
    OUT=$W/sparse_plus_$ROUND
    mkdir -p "$OUT"
    colmap image_registrator --database_path "$W/database.db" \
        --input_path "$IN" --output_path "$OUT" || break
    colmap bundle_adjuster --input_path "$OUT" --output_path "$OUT" || break
    N=$(python -c "
import struct;print(struct.unpack('<Q', open('$OUT/images.bin','rb').read(8))[0])")
    echo "round $ROUND: $N registered images"
    IN=$OUT
done
# final: retriangulate to densify the point cloud that seeds 3DGS
colmap point_triangulator --database_path "$W/database.db" --image_path "$W/images" \
    --input_path "$IN" --output_path "$IN" || true
echo; echo "=== FINAL ==="
colmap model_analyzer --path "$IN" 2>&1 | grep -E "Registered|Points|reprojection|Cameras"
python - <<PY
import struct
p = "$IN/images.bin"
with open(p,"rb") as f:
    n = struct.unpack("<Q", f.read(8))[0]; pre={}
    for _ in range(n):
        f.read(4+32+24+4); name=b""
        while True:
            c=f.read(1)
            if c==b"\x00": break
            name+=c
        k=struct.unpack("<Q", f.read(8))[0]; f.read(k*24)
        s=name.decode().split("/")[0]; pre[s]=pre.get(s,0)+1
print("per-source:", pre, "total", n)
PY
echo "rc=$?"
