#!/bin/bash
#SBATCH --account=aip-rhinehar
#SBATCH --job-name=gs_s5nr
#SBATCH --nodes=1
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=2:59:00
#SBATCH --output=/scratch/yifanr/gsbench/logs/gs_s5nr_%j.out
#SBATCH --error=/scratch/yifanr/gsbench/logs/gs_s5nr_%j.out
#
# ARM B: v2 on scan5's OWN model (498/500 registered, continuous 4K sweep -- the
# best solve we have) with the robot + off-cell frames excluded from TRAINING
# only. Avoids the merged model's fragmentation entirely.
# scan5 = 7201 source frames; robot 0-14.5% -> 0..1044, off-cell 36-51% -> 2592..3672.
set -uo pipefail
cd /scratch/yifanr/gsbench
CU=/cvmfs/soft.computecanada.ca/easybuild/software/2023/x86-64-v3/Core/cudacore/12.9.1
export CUDA_HOME=$CU PATH=$CU/bin:$PATH LD_LIBRARY_PATH=$CU/lib64:${LD_LIBRARY_PATH:-}
export TORCH_CUDA_ARCH_LIST="8.9;9.0" MUJOCO_GL=egl
source .venv/bin/activate
nvidia-smi --query-gpu=name --format=csv,noheader
python train_3dgs_v2.py \
    --colmap_dir sfm_scan5/sparse/1 --image_dir sfm_scan5/images \
    --output sfm_scan5/scene_v2_norobot.ply \
    --iterations 30000 --max_long_side 1600 --bg_color_json wall_color.json \
    --world_transform scene5_world_transform.json \
    --exclude_idx_ranges "0-1044,2592-3672" \
    --eval_every 5000 --val_render_dir /scratch/yifanr/gsbench/val_pairs_s5nr
echo "train rc=$?"
python render_zed_pov.py --ply sfm_scan5/scene_v2_norobot.ply --out pov_after_s5nr
echo "rc=$?"
