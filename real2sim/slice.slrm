#!/bin/bash
#SBATCH --account=aip-gigor
#SBATCH --job-name=gs_slice
#SBATCH --nodes=1
#SBATCH --gres=gpu:l40s:1
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=0:29:00
#SBATCH --output=/scratch/yifanr/gsbench/logs/slice_%j.out
#SBATCH --error=/scratch/yifanr/gsbench/logs/slice_%j.out
set -uo pipefail
cd /scratch/yifanr/gsbench; mkdir -p logs slice
CU=/cvmfs/soft.computecanada.ca/easybuild/software/2023/x86-64-v3/Core/cudacore/12.9.1
export CUDA_HOME=$CU PATH=$CU/bin:$PATH LD_LIBRARY_PATH=$CU/lib64:${LD_LIBRARY_PATH:-}
export TORCH_CUDA_ARCH_LIST="8.9" MUJOCO_GL=egl
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
source .venv/bin/activate
nvidia-smi --query-gpu=name --format=csv,noheader
python render_slice.py --res 512 --cam frontview
echo "rc=$?"
