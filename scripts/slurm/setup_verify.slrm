#!/bin/bash
#SBATCH --account=aip-gigor
#SBATCH --job-name=setup_verify
#SBATCH --nodes=1
#SBATCH --gres=gpu:l40s:1
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=2:59:00
#SBATCH --output=logs/setup_verify_%j.out
#SBATCH --error=logs/setup_verify_%j.out
#
# ★ SLURM SIZING (walltime tiers on this cluster, measured 2026-08-26):
#     b1 <= 3:00:00   168 nodes      b2 <= 12:00:00
#     b3 <= 1-00:00:00  84 nodes     b4 <= 3-00:00:00   42 nodes
#   Requesting just OVER a boundary is very expensive: a 4h job priced into the
#   12h tier waited 15h23m, where 2:59:00 would have gone to b1 and started in
#   minutes. Our 3-day jobs waited 8-15h; the group median is ~1 minute.
#   So: always sit just UNDER a boundary (2:59:00 / 11:59:00 / 23:59:00), and
#   keep CPU/mem small -- large asks shrink the set of nodes with a free slot
#   next to an idle GPU. Right-size from `sacct -o Elapsed,MaxRSS`, not guesses.
#   This job: measured ~1h; 2:59 = just under the b1 boundary
#
# Finishes Phase 0 and verifies it, on a compute node.
#
# Why not on the login node: building common_utils/rela there gets the compiler
# OOM-killed ("c++: fatal error: Killed signal terminated program cc1plus").
# Torch-heavy translation units want GBs each, and login nodes cap per-user
# memory. Also keep parallelism modest -- -j8 was what triggered the kill.
#
# L40S rather than H100 on purpose: the render benchmark spawns 10 worker
# processes, each with its own MuJoCo env + EGL context. L40S allows ~16 CPU
# cores/GPU; H100 gives ~6 (8 GPUs over 48 cores) and cannot host 10 workers.
#
# Submit from the repo root:  mkdir -p logs && sbatch scripts/slurm/setup_verify.slrm

set -uo pipefail

cd "$SLURM_SUBMIT_DIR"
source set_env_drac.sh

echo "=== node $(hostname) | cpus ${SLURM_CPUS_PER_TASK} | $(nvidia-smi --query-gpu=name --format=csv,noheader | head -1) ==="

# ---------------------------------------------------------------- 1. build
echo; echo "########## 1. build common_utils/rela ##########"
( cd common_utils && rm -rf build && make -j4 )
echo "make rc=$?"

# --------------------------------------------------------- 2. import chain
echo; echo "########## 2. import chain ##########"
python - <<'PY'
import numpy, torch, mujoco, cv2
print(f"numpy {numpy.__version__} | torch {torch.__version__} | "
      f"mujoco {mujoco.__version__} | cv2 {cv2.__version__}")
print("cuda available:", torch.cuda.is_available(),
      "|", torch.cuda.get_device_name(0) if torch.cuda.is_available() else "-")
import robosuite, robomimic, mimicgen
print("robosuite", robosuite.__version__, "| robomimic", robomimic.__version__)
from common_utils import rela            # the C++ extension built above
print("rela OK")
PY
echo "imports rc=$?"

# ------------------------------------------- 3. functional env + strict success
# The real check: does a Threading_D0 env build, reset, step, and does the
# domain-shift + strict-success machinery resolve its MuJoCo bindings?
echo; echo "########## 3. Threading_D0 env, state mode ##########"
python - <<'PY'
import numpy as np, torch
from env.robosuite_wrapper import PixelRobosuite
from env.domain_shift import DomainShiftConfig
from env.strict_success import StrictSuccessConfig

# the §12 dynamics-only TARGET recipe -- exercises resolve_bindings + all shift fns
shift = DomainShiftConfig(
    mode="fixed", friction_scale=0.5, mass_scale=3.0, solref_scale=1.0,
    solimp_scale=1.0, gripper_kp_scale=0.12, hole_offset=[0.0, 0.0, 0.0],
    ring_size_scale=0.85, ring_friction_scale=2.0, mask_hole_offset_in_obs=False,
)
for label, sh in [("source (no shift)", DomainShiftConfig(mode="none")),
                  ("target (§12 dynamics-only)", shift)]:
    env = PixelRobosuite(
        env_name="Threading_D0", robots=["Panda"], episode_length=400,
        use_state=True, obs_stack=1, state_stack=1, prop_stack=1,
        camera_names=[], rl_cameras=[], end_on_success=True,
        domain_shift=sh, state_only_no_render=True,
        strict_success=StrictSuccessConfig(enabled=True, dwell_steps=3,
                                          max_tripod_disp=0.04),
        device="cpu",
    )
    obs, _ = env.reset()
    rng = np.random.RandomState(0)
    for _ in range(50):
        obs, r, term, succ, _ = env.step(
            torch.from_numpy(rng.uniform(-0.2, 0.2, env.action_dim).astype(np.float32)))
        if term:
            break
    print(f"  {label}: state{tuple(obs['state'].shape)} prop{tuple(obs['prop'].shape)} "
          f"obs_shape={env.observation_shape} action_dim={env.action_dim}")
    del env
print("env OK")
PY
echo "env rc=$?"

# ------------------------------------------------------ 4. render benchmark
echo; echo "########## 4. render throughput (the pixel go/no-go) ##########"
python scripts/bench_render.py --n_steps 300 --n_proc 10
echo "bench rc=$?"

echo; echo "=== setup_verify complete ==="
