#!/bin/bash
#SBATCH --account=aip-gigor
#SBATCH --job-name=ab_zedpov
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --partition=gpubase_interac
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=0:24:00
#SBATCH --output=logs/ab_zedpov_%j.out
#SBATCH --error=logs/ab_zedpov_%j.out
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
source set_env_drac.sh
export PYTHONPATH=$PYTHONPATH:/scratch/yifanr/realsim_survey/_GaussianRenderer/src:/scratch/yifanr/gsbench
python - <<'WARM'
import gsplat
from gsplat.cuda._backend import _C
WARM
python /scratch/yifanr/gsbench/ab_zedpov.py
echo "rc=$?"
