#!/bin/bash
#SBATCH --account=aip-rhinehar
#SBATCH --job-name=objsplat_render
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --partition=gpubase_interac
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=0:29:00
#SBATCH --output=/scratch/yifanr/gsbench/logs/objsplat_%j.out
#SBATCH --error=/scratch/yifanr/gsbench/logs/objsplat_%j.out
# gsplat needs CUDA, so this cannot run on a login node. Short (b1).
set -uo pipefail
cd /scratch/yifanr/gsbench
CU=/cvmfs/soft.computecanada.ca/easybuild/software/2023/x86-64-v3/Core/cudacore/12.9.1
export CUDA_HOME=$CU PATH=$CU/bin:$PATH LD_LIBRARY_PATH=$CU/lib64:${LD_LIBRARY_PATH:-}
source .venv/bin/activate
export MUJOCO_GL=egl
nvidia-smi --query-gpu=name --format=csv,noheader
python /project/6101830/yifanr/SimDist_ibrl/real2sim/scan_pipeline/render_object_splats.py
echo "rc=$?"
