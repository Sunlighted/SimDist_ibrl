#!/bin/bash
#SBATCH --account=aip-gigor
#SBATCH --job-name=bench224
#SBATCH --nodes=1
#SBATCH --gres=gpu:l40s:1
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=0:29:00
#SBATCH --output=logs/bench224_%j.out
#SBATCH --error=logs/bench224_%j.out
#
# ★ SLURM SIZING: 0:29:00 -> b1. "Do not launch a 224 run on an estimate."
#
# Gates the 224 + ImageNet-ResNet-18 decision with MEASURED numbers:
#   (a) encoder ms/gradient-step for vit@96 (current) vs resnet18@96 vs
#       resnet18@224 -- the doc only ever had a 200-400 ms/step EXTRAPOLATION;
#   (b) JPEG decode throughput at the real per-step frame count
#       (batch 256 x H+1=6 x 2 cameras = 3072 frames/step), because a
#       RAM-resident raw buffer is impossible at 224 and decode must not
#       starve the GPU;
#   (c) the resulting walltime at 2 epochs (the reference budget) vs 800k steps.
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
source set_env_drac.sh

python - <<'PY'
import time, torch, numpy as np
import torchvision.io as tvio
from networks.encoder import (ResNet18PretrainedEncoder, ResNet18PretrainedEncoderConfig,
                              VitEncoder, VitEncoderConfig)

B_ENC = 512          # batch 256 x 2 cameras -- the real per-encode-call size
CALLS_NOGRAD, CALLS_GRAD = 6, 1     # encode calls per step after the dedup


def bench_enc(name, mk, shape, n=10, warm=3):
    try:
        enc = mk(shape).cuda()
    except Exception as e:
        print(f"{name:28s} BUILD FAILED: {type(e).__name__}: {e}")
        return None
    p = sum(q.numel() for q in enc.parameters())
    tr = sum(q.numel() for q in enc.parameters() if q.requires_grad)
    x = torch.randint(0, 256, (B_ENC, *shape), dtype=torch.uint8, device="cuda").float()
    try:
        with torch.no_grad():
            for i in range(n):
                if i == warm:
                    torch.cuda.synchronize(); t0 = time.time()
                enc(x, flatten=True)
            torch.cuda.synchronize()
        fwd = (time.time() - t0) / (n - warm)
        for i in range(n):
            if i == warm:
                torch.cuda.synchronize(); t0 = time.time()
            enc(x, flatten=True).sum().backward()
            enc.zero_grad(set_to_none=True)
        torch.cuda.synchronize()
        fb = (time.time() - t0) / (n - warm)
    except torch.cuda.OutOfMemoryError:
        print(f"{name:28s} OOM at batch {B_ENC}")
        del enc, x; torch.cuda.empty_cache()
        return None
    with torch.no_grad():
        rd = enc(x[:2], flatten=True).shape[-1]
    step = CALLS_NOGRAD * fwd + CALLS_GRAD * fb
    print(f"{name:28s} {p:11,d} {tr:11,d} {rd:8d} {1000*fwd:8.1f} {1000*fb:9.1f} "
          f"{1000*step:10.1f}")
    del enc, x; torch.cuda.empty_cache()
    return step


print("ENCODER COST  (batch %d = 256 x 2 cameras; step = %d no_grad + %d fwd/bwd)"
      % (B_ENC, CALLS_NOGRAD, CALLS_GRAD))
print(f"{'encoder':28s} {'params':>11s} {'trainable':>11s} {'repr':>8s} "
      f"{'fwd ms':>8s} {'f+b ms':>9s} {'enc/step':>10s}")
print("-" * 92)
res = {}
res["vit@96 (current)"] = bench_enc(
    "vit embed2/d1 @96", lambda s: VitEncoder(s, VitEncoderConfig(embed_style="embed2", depth=1)), [3, 96, 96])
res["resnet18@96"] = bench_enc(
    "resnet18 imagenet @96", lambda s: ResNet18PretrainedEncoder(s, ResNet18PretrainedEncoderConfig()), [3, 96, 96])
res["resnet18@224"] = bench_enc(
    "resnet18 imagenet @224", lambda s: ResNet18PretrainedEncoder(s, ResNet18PretrainedEncoderConfig()), [3, 224, 224])
res["resnet18@224 frozen1-2"] = bench_enc(
    "resnet18 @224 freeze 2 stg", lambda s: ResNet18PretrainedEncoder(
        s, ResNet18PretrainedEncoderConfig(freeze_stages=2)), [3, 224, 224])

# ---------------------------------------------------------------- JPEG decode
print("\nJPEG DECODE  (frames/gradient-step = batch 256 x (H+1)=6 x 2 cameras = 3072)")
print(f"{'resolution':14s} {'q':>4s} {'B/frame':>9s} {'ratio':>7s} "
      f"{'gpu ms/step':>12s} {'cpu ms/step':>12s}")
print("-" * 66)
FRAMES_PER_STEP = 256 * 6 * 2
for res_px in (96, 224):
    ys, xs = np.mgrid[0:res_px, 0:res_px].astype(np.float32)
    base = (np.sin(xs / 11.0) + np.cos(ys / 13.0) + 2) * 60
    img = np.clip(np.stack([base + 20 * c for c in range(3)]), 0, 255).astype(np.uint8)
    for q in (95, 85):
        buf = tvio.encode_jpeg(torch.from_numpy(img), quality=q)
        raw_b = img.nbytes
        ratio = raw_b / buf.numel()
        bufs = [buf.clone() for _ in range(FRAMES_PER_STEP)]
        gpu_ms = cpu_ms = float("nan")
        try:
            for i in range(4):
                if i == 2:
                    torch.cuda.synchronize(); t0 = time.time()
                tvio.decode_jpeg(bufs, mode=tvio.ImageReadMode.RGB, device="cuda")
            torch.cuda.synchronize()
            gpu_ms = 1000 * (time.time() - t0) / 2
        except Exception as e:
            print(f"    gpu decode failed: {type(e).__name__}: {e}")
        try:
            sub = bufs[:256]
            t0 = time.time()
            tvio.decode_jpeg(sub, mode=tvio.ImageReadMode.RGB, device="cpu")
            cpu_ms = 1000 * (time.time() - t0) * (FRAMES_PER_STEP / len(sub))
        except Exception as e:
            print(f"    cpu decode failed: {type(e).__name__}: {e}")
        print(f"{res_px}x{res_px:<9d} {q:>4d} {buf.numel():>9d} {ratio:>6.1f}x "
              f"{gpu_ms:>12.1f} {cpu_ms:>12.1f}")

# ---------------------------------------------------------------- budgets
print("\nWALLTIME (encoder time only; MLP heads + optimizer add on top)")
print(f"{'config':28s} {'ms/step':>9s} {'160k (2 ep)':>13s} {'800k':>10s}")
print("-" * 64)
for k, v in res.items():
    if v is None:
        continue
    print(f"{k:28s} {1000*v:9.1f} {v*160_000/3600:12.1f}h {v*800_000/3600:9.1f}h")
print("\nreference recipe = 2 epochs. At 100k traj (~20.4M transitions) and batch"
      " 256, 2 epochs = 160k steps.")
PY
echo "bench224 rc=$?"
