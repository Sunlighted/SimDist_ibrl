#!/bin/bash
#SBATCH --account=aip-gigor
#SBATCH --job-name=conv_thread_state
#SBATCH --nodes=1
#SBATCH --gres=gpu:l40s:1
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=2:59:00
#SBATCH --output=logs/convert_state_%j.out
#SBATCH --error=logs/convert_state_%j.out
#
# ★ SLURM SIZING (walltime tiers on this cluster, measured 2026-08-26):
#     b1 <= 3:00:00   168 nodes      b2 <= 12:00:00
#     b3 <= 1-00:00:00  84 nodes     b4 <= 3-00:00:00   42 nodes
#   Requesting just OVER a boundary is very expensive: a 4h job priced into the
#   12h tier waited 15h23m, where 2:59:00 would have gone to b1 and started in
#   minutes. Our 3-day jobs waited 8-15h; the group median is ~1 minute.
#   So: always sit just UNDER a boundary (2:59:00 / 11:59:00 / 23:59:00), and
#   keep CPU/mem small -- large asks shrink the set of nodes with a free slot
#   next to an idle GPU. Right-size from `sacct -o Elapsed,MaxRSS`, not guesses.
#   This job: measured 53:03; 2:59 = just under the b1 boundary
#
# STATE-ONLY conversion of the MimicGen core threading_d0 dataset into ibrl
# format. This is the critical-path artifact: it feeds the flow-BC prior
# (threading_d0_state_flow_bc.yaml `dataset.path`) and IBRL's `preload_datapath`,
# i.e. the privileged STATE teacher that both the state and pixel arms share.
#
# No --camera_names, so no rendering: the script replays each demo's recorded
# sim states through the env and re-extracts low-dim obs. ~224k steps total.
#
# NOTE on images: the downloaded MimicGen file already embeds agentview +
# eye_in_hand at 84x84 (gzip, HWC) for all 1000 demos. We deliberately do NOT
# use them -- (a) 84x84 != the 96x96 that ResNet96Encoder/VitEncoder expect
# (min_vit hardcodes 96 patch counts), and (b) nothing in the pixel plan
# consumes MimicGen images anyway: the world model trains on the source replay
# generated by generate_simdist_data.py, and the teacher is state-based. So the
# expensive --camera_names re-render is not on anyone's critical path.
#
# A GPU is requested only because robosuite may construct a GL context during
# env setup even with no cameras; the job itself is CPU/physics bound.
#
# Submit from the repo root:  sbatch scripts/slurm/convert_threading_state.slrm

set -uo pipefail

cd "$SLURM_SUBMIT_DIR"
source set_env_drac.sh

IN=release/data/mimicgen/core/threading_d0.hdf5
OUT=release/data/mimicgen/core/threading_d0

echo "=== node $(hostname) | in=$IN ($(du -h $IN | cut -f1)) ==="

python tools/dataset_states_to_obs.py \
    --dataset "$IN" \
    --output_folder "$OUT" \
    --done_mode 2
rc=$?
echo "convert rc=$rc"

echo "=== output ==="
ls -la "$OUT" || true

# Verify the artifact rather than trusting the exit code.
python - <<'PY'
import h5py, numpy as np, os
p = "release/data/mimicgen/core/threading_d0/processed_data96.hdf5"
if not os.path.exists(p):
    raise SystemExit(f"MISSING {p}")
f = h5py.File(p, "r")
demos = sorted(f["data"].keys(), key=lambda k: int(k.split("_")[1]))
keys = ["robot0_eef_pos", "robot0_eef_quat", "robot0_gripper_qpos", "object"]
dims = {k: f[f"data/{demos[0]}/obs"][k].shape[1] for k in keys}
print("demos:", len(demos))
print("state dims:", dims, "TOTAL =", sum(dims.values()))
print("obs keys:", sorted(f[f"data/{demos[0]}/obs"].keys()))
lens = np.array([f[f"data/{d}"]["actions"].shape[0] for d in demos])
print(f"steps/demo mean {lens.mean():.1f}")
succ = sum(1 for d in demos if np.asarray(f[f"data/{d}"]["rewards"]).max() >= 1)
print(f"success {succ}/{len(demos)} = {100*succ/len(demos):.1f}%")
f.close()
PY
echo "verify rc=$?"
echo "=== done ==="
